<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- THE version. The in-app updater compares against it and the macOS packaging script reads it
         straight out of this file, so a release can never ship a bundle whose Info.plist and update
         manifest disagree with the binary. -->
    <Version>1.2.7</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- macOS port: publishable for Apple Silicon and Intel Macs (tools/publish-macos.ps1). The
         Windows PE bits (Win32 manifest, .ico embedding) only apply to win RIDs / RID-less dev builds. -->
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">Assets\lumenotepad.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- CA1416: every Windows-only call site (DWM acrylic, registry, hotkey) is guarded with
         OperatingSystem.IsWindows(); the remaining analyzer noise is PDFium/SkiaSharp annotations that
         list explicit platforms we do target. AVLN3001: chromeless windows with parameterized ctors are
         never loaded via the runtime XAML loader; the warning is benign. -->
    <NoWarn>$(NoWarn);CA1416;AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="PDFtoImage" />   <!-- native PDFium page rendering (no browser engine) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
