<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumenotepad.ViewModels"
        xmlns:controls="using:Lumenotepad.Controls"
        x:Class="Lumenotepad.Views.PreferencesWindow"
        x:DataType="vm:MainViewModel"
        Title="Preferences"
        Width="920" Height="680" MinWidth="620" MinHeight="440"
        WindowDecorations="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextRenderingMode="Antialias"
        Background="{DynamicResource WindowSurfaceBrush}"
        TransparencyLevelHint="AcrylicBlur, Transparent, None">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>
        <!-- Category heading shown atop each panel while a search is active -->
        <Style Selector="TextBlock.searchcat">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <!-- Inline code/text fields + secondary buttons across the panels wear the app's themed
             controls (raw Fluent defaults clashed — owner report). Explicitly-themed controls keep
             their own theme (a local Theme= beats these Style setters). -->
        <Style Selector="TextBox.field">
            <Setter Property="Theme" Value="{StaticResource RoundedFieldTextBox}"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Theme" Value="{StaticResource LumenButtonGray}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
            <Setter Property="MinWidth" Value="0"/>
            <!-- Interaction motion: Opacity/Brush transitions animate in this build (RenderTransform
                 does not — see App.axaml + the motion spec); the knob slide is Fluent's own. -->
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions>
            </Setter>
        </Style>
        <!-- Smooth press feedback for the prefs comboboxes + sliders (Fluent drives the popup/thumb). -->
        <Style Selector="ComboBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox:pressed">
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions>
            </Setter>
        </Style>
        <!-- theme picker chips -->
        <Style Selector="ListBox.themepick ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <!-- left category nav -->
        <Style Selector="ListBox.prefnav ListBoxItem">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="ListBox.prefnav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="ListBox.prefnav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.prefnav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="ListBox.prefnav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
        <!-- fonts checklist rows: plain checkbox rows, no selection fill -->
        <Style Selector="ListBox.fontcheck ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style Selector="ListBox.fontcheck ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.fontcheck ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Hover help: a small ring the Border draws itself (so glyph and circle are always
             concentric), with the help glyph tiny inside it. Ring + glyph both sweep to the accent
             on hover via brush transitions — RenderTransform styles are dead in this build. -->
        <Style Selector="Border.qmark">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="(ToolTip.ShowDelay)" Value="350"/>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.15"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.qmark:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.qmark > TextBlock">
            <Setter Property="Text" Value="&#xE897;"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.15"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.qmark:pointerover > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel>
        <!-- mini title bar — same height + close-button margin as the main window -->
        <Grid DockPanel.Dock="Top" Height="38" ColumnDefinitions="*,Auto" x:Name="PrefsTitleBar"
              Background="Transparent">
            <TextBlock Text="Preferences" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button x:Name="CloseBtn" Grid.Column="1" Theme="{StaticResource CloseCaptionButton}"
                    Content="&#xE8BB;" VerticalAlignment="Center" Margin="0,0,3,0"/>
        </Grid>

        <!-- Search across every category (declutter): type to filter all settings at once. -->
        <Border DockPanel.Dock="Top" Padding="16,0,16,8">
            <TextBox x:Name="SearchBox" Theme="{StaticResource RoundedFieldTextBox}" FontSize="13"
                     MinHeight="34" Padding="10,8" VerticalContentAlignment="Center"
                     PlaceholderText="Search settings…"/>
        </Border>

        <Grid ColumnDefinitions="158,*">

            <!-- category nav -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource FrameBorderBrush}"
                    BorderThickness="0,0,1,0" Padding="8,4">
                <ListBox x:Name="NavList" Classes="prefnav" Background="Transparent"
                         BorderThickness="0" Padding="0">
                    <ListBoxItem Tag="general"><TextBlock Classes="label" Text="General"/></ListBoxItem>
                    <ListBoxItem Tag="appearance"><TextBlock Classes="label" Text="Appearance"/></ListBoxItem>
                    <ListBoxItem Tag="layout"><TextBlock Classes="label" Text="Layout"/></ListBoxItem>
                    <ListBoxItem Tag="canvas"><TextBlock Classes="label" Text="Canvas"/></ListBoxItem>
                    <ListBoxItem Tag="editor"><TextBlock Classes="label" Text="Editor"/></ListBoxItem>
                    <ListBoxItem Tag="shortcuts"><TextBlock Classes="label" Text="Shortcuts"/></ListBoxItem>
                    <ListBoxItem IsEnabled="False" Margin="0,10,0,0" Padding="10,2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="GateLock" Text="&#xE72E;" FontFamily="{StaticResource IconFont}"
                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="ADVANCED" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="fonts"><TextBlock Classes="label" Text="Fonts"/></ListBoxItem>
                    <ListBoxItem Tag="bullets"><TextBlock Classes="label" Text="Bullets &amp; numbers"/></ListBoxItem>
                    <ListBoxItem Tag="data"><TextBlock Classes="label" Text="Data &amp; tools"/></ListBoxItem>
                    <ListBoxItem Tag="about" Margin="0,10,0,0"><TextBlock Classes="label" Text="About"/></ListBoxItem>
                </ListBox>
            </Border>

            <!-- category panels (one visible at a time; ShowPanel swaps + animates).
                 x:Name so SmoothScroll can attach wheel-eased scrolling in the code-behind. -->
            <ScrollViewer x:Name="PrefsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanelsHost" Spacing="14" Margin="20,4,20,18">
                    <TextBlock x:Name="SearchEmptyNote" Classes="hint" IsVisible="False"
                               Text="No settings match your search." Margin="0,8,0,0"/>

                    <StackPanel x:Name="GeneralPanel" Spacing="6">
                        <TextBlock Classes="section" Text="STARTUP" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="When Lumenotepad opens"/>
                                    <Border Classes="qmark" ToolTip.Tip="What you see when the app opens. 'Home page' shows all your notebooks; 'Last page' jumps straight back to where you left off."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="LaunchTargetBox" Grid.Column="1" Width="150" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="StartupRow" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Start with Windows"/>
                                    <Border Classes="qmark" ToolTip.Tip="Adds Lumenotepad to the programs that start automatically when you sign in to Windows, so it is ready without opening it yourself."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Always on top"/>
                                    <Border Classes="qmark" ToolTip.Tip="Keeps the Lumenotepad window floating above every other window, even after you click somewhere else."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="SYSTEM TRAY"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Close to tray"/>
                                    <Border Classes="qmark" ToolTip.Tip="The close button hides the window near the clock instead of quitting. Right-click the tray icon to quit for good."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Minimize to tray"/>
                                    <Border Classes="qmark" ToolTip.Tip="The minimize button hides the window near the clock instead of the taskbar."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="SummonRow" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Global shortcut (Ctrl+Alt+N)"/>
                                    <Border Classes="qmark" ToolTip.Tip="Press Ctrl+Alt+N from any program to bring Lumenotepad to the front, even if it is hidden in the tray. Turn this off if another program already uses that combination."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SummonHotkey, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="SAVING"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Autosave after typing stops"/>
                                <Border Classes="qmark" ToolTip.Tip="How long Lumenotepad waits after you stop typing before saving your work. Shorter is safer, longer is quieter."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="AutosaveValue" Grid.Column="1" Classes="hint" Text="0.9s"/>
                        </Grid>
                        <Slider x:Name="AutosaveSlider" Minimum="100" Maximum="5000"
                                TickFrequency="100"/>

                        <TextBlock Classes="section" Text="HOMEPAGE"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Jump back in entries"/>
                                    <Border Classes="qmark" ToolTip.Tip="How many of your most recent pages show up in the 'Jump back in' row on the home screen. Set it to zero to hide that row completely."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="RecentCountValue" Grid.Column="1" Classes="label" Text="5"/>
                        </Grid>
                        <Slider x:Name="RecentCountSlider" Minimum="0" Maximum="10"
                                TickFrequency="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Greet me as"/>
                                    <Border Classes="qmark" ToolTip.Tip="The name Lumenotepad uses to greet you on the home screen. Leave it blank for a plain greeting with no name."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBox x:Name="UserNameBox" Classes="field" Grid.Column="1" Width="150" FontSize="12.5"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Show notebook &amp; page counts"/>
                                <Border Classes="qmark" ToolTip.Tip="Shows small numbers on the home screen telling you how many notebooks and pages you have."><TextBlock/></Border>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHomeStats, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="ASK BEFORE DELETING"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Notebooks"/>
                                <Border Classes="qmark" ToolTip.Tip="Asks you to confirm before a notebook is deleted, so you do not lose one by accident."><TextBlock/></Border>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmDeleteNotebook, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Sections"/>
                                <Border Classes="qmark" ToolTip.Tip="Asks you to confirm before a section is deleted, so you do not lose one by accident."><TextBlock/></Border>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmDeleteSection, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Pages"/>
                                <Border Classes="qmark" ToolTip.Tip="Asks you to confirm before a page is deleted, so you do not lose one by accident."><TextBlock/></Border>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmDeletePage, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Note containers"/>
                                    <Border Classes="qmark" ToolTip.Tip="Asks you to confirm before a note box on the page is deleted. Even without this, deleted note boxes can be brought back from the page's history."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmDeleteContainer, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel" Spacing="6" IsVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="THEME" Margin="0,4,0,2"/>
                            <Border Classes="qmark" Margin="6,2,0,0" ToolTip.Tip="Pick the overall look of Lumenotepad. Click a theme to switch to it right away — the other appearance options below adjust to match."><TextBlock/></Border>
                        </StackPanel>
                        <ListBox x:Name="ThemeList" Classes="themepick" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Full theme"/>
                                    <Border Classes="qmark" ToolTip.Tip="When on, the page you write on matches the surrounding window instead of standing out from it."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding FullTheme, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding PaperToggleEnabled}">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Light paper"/>
                                    <Border Classes="qmark" ToolTip.Tip="Only matters with the Lumen theme when Full theme is off. Switches the writing page to a light background instead of a dark one."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PaperLight, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Flat covers"/>
                                    <Border Classes="qmark" ToolTip.Tip="Notebook covers are shown as plain flat colors instead of with a shiny highlight. Shadows underneath stay the same."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding FlatCovers, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Glossy accents"/>
                                    <Border Classes="qmark" ToolTip.Tip="Adds a subtle shine to selected tabs, rows, and the cards on the home screen."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GlossyAccents, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="ACCENT"/>
                            <Border Classes="qmark" Margin="6,2,0,0" ToolTip.Tip="Pick the highlight color used throughout Lumenotepad, for things like buttons, selected items, and the typing line."><TextBlock/></Border>
                        </StackPanel>
                        <WrapPanel x:Name="AccentSwatches"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <Border Classes="qmark" ToolTip.Tip="The highlight color used for buttons and selections. Type a color code like #4DA6FF, or press Enter on an empty box to go back to the theme's own color."><TextBlock/></Border>
                            </StackPanel>
                            <TextBox x:Name="AccentHexBox" Classes="field" Grid.Column="1" Width="110" FontSize="12.5"
                                     PlaceholderText="#RRGGBB" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="GLASS"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Glass tint"/>
                                <Border Classes="qmark" ToolTip.Tip="Makes the see-through parts of the window lighter or darker. Zero leaves them as they are."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="GlassTintValue" Grid.Column="1" Classes="hint" Text="0%"/>
                        </Grid>
                        <Slider x:Name="GlassTintSlider" Minimum="-1" Maximum="1"
                                TickFrequency="0.05"/>

                        <!-- macOS only: macOS picks the frost recipe, not the app, and its default is far
                             paler than the Windows acrylic. Shown only where it does something. -->
                        <Grid x:Name="MacMaterialRow" ColumnDefinitions="*,Auto" IsVisible="False" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Glass material"/>
                                <Border Classes="qmark" ToolTip.Tip="macOS only. Which of the system's frosted-glass recipes the main window, the menus and the message boxes sit on. macOS has no separate blur-strength setting — this is it. Standard is the tightest and most like the Windows look; Sheer lets the most through."><TextBlock/></Border>
                            </StackPanel>
                            <ComboBox x:Name="MacMaterialBox" Grid.Column="1" Width="150" FontSize="12.5">
                                <ComboBoxItem Content="Standard"/>
                                <ComboBoxItem Content="Deep"/>
                                <ComboBoxItem Content="Balanced"/>
                                <ComboBoxItem Content="Sheer"/>
                                <ComboBoxItem Content="System"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Classes="section" Text="SHAPE"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Corner roundness"/>
                                <Border Classes="qmark" ToolTip.Tip="How rounded the page and the note containers look. Lower is squarer, higher is softer. 100% is the normal look."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="RoundnessValue" Grid.Column="1" Classes="hint" Text="100%"/>
                        </Grid>
                        <Slider x:Name="RoundnessSlider" Minimum="0.5" Maximum="1.5" TickFrequency="0.05"/>

                        <TextBlock Classes="section" Text="MOTION"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Reduce motion"/>
                                    <Border Classes="qmark" ToolTip.Tip="Turns off Lumenotepad's animations. Windows, panels and lists appear and disappear instantly instead of sliding or fading."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Animation speed"/>
                                    <Border Classes="qmark" ToolTip.Tip="How fast Lumenotepad's animations play. Choose a quicker or slower feel, or turn them off entirely with Reduce motion above."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="MotionSpeedBox" Grid.Column="1" Width="120" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="GALLERY"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Accent follows notebook"/>
                                    <Border Classes="qmark" ToolTip.Tip="While a notebook is open, its cover color becomes the highlight color for the whole app instead of your usual accent."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AccentFollowsNotebook, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Cover size"/>
                                <Border Classes="qmark" ToolTip.Tip="How big the notebook covers appear on the home screen. Bigger covers mean fewer fit on screen at once."><TextBlock/></Border>
                            </StackPanel>
                            <ComboBox x:Name="CardSizeBox" Grid.Column="1" Width="120" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="LayoutPanel" Spacing="6" IsVisible="False">
                        <TextBlock Classes="section" Text="TOOLBAR" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Toolbar position"/>
                                <Border Classes="qmark" ToolTip.Tip="Which edge of the window the formatting toolbar sits against — top, bottom, left, or right."><TextBlock/></Border>
                            </StackPanel>
                            <ComboBox x:Name="ToolbarPosBox" Grid.Column="1" Width="120"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Attach toolbar to"/>
                                    <Border Classes="qmark" ToolTip.Tip="Whether the toolbar stays fixed to the window's edge, or moves to hug the page you are writing on."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="ToolbarScopeBox" Grid.Column="1" Width="120" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Classes="section" Text="PANELS"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Show notebooks rail"/>
                                    <Border Classes="qmark" ToolTip.Tip="Whether the strip of notebooks on the left is visible when Lumenotepad opens. You can still show or hide it anytime with the toolbar button."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartRailVisible, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Show pages panel"/>
                                    <Border Classes="qmark" ToolTip.Tip="Whether the list of pages is visible when Lumenotepad opens. You can still show or hide it anytime with the toolbar button."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartPagesVisible, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Sections in their own sidebar"/>
                                    <Border Classes="qmark" ToolTip.Tip="Moves your sections into a separate strip beside the notebooks, instead of listing them above the pages. Handy when a notebook has lots of sections."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SectionsSidebar, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Single mode (pages only, no sections)"/>
                                    <Border Classes="qmark" ToolTip.Tip="Turns off sections so a notebook is just a flat list of pages. Turning this on gathers all of a notebook's pages together; turning it back off gives every page its own section again."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SingleMode, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="CanvasPanel" Spacing="6" IsVisible="False">
                        <TextBlock Classes="section" Text="PAGES" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Resizable pages"/>
                                    <Border Classes="qmark" ToolTip.Tip="Note boxes on the page show small handles on their edges and corners so you can drag them to resize."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ResizablePages, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Always show container borders"/>
                                    <Border Classes="qmark" ToolTip.Tip="Note boxes keep a faint outline all the time. Off, the outline fades in only when you point at a box, so the page looks cleaner."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysShowBorders, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Deleted pages history"/>
                                    <Border Classes="qmark" ToolTip.Tip="Keeps a copy of deleted note boxes so you can drag them back onto the page later. Turn this off to delete them for good right away."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding DeletedHistory, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Mind-map tidy layout"/>
                                    <Border Classes="qmark" ToolTip.Tip="How the mind-map Tidy button arranges bubbles: Radial fans them in every direction; Hybrid sends branches with children left and right and single bubbles to the top and bottom; Top-down stacks the map as a hierarchy."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="TidyLayoutBox" Grid.Column="1" Width="140" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="New container width"/>
                                <Border Classes="qmark" ToolTip.Tip="How wide a new note box is when you first create it. You can still resize any note box afterward."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="NewNoteWidthValue" Grid.Column="1" Classes="label" Text="360"/>
                        </Grid>
                        <Slider x:Name="NewNoteWidthSlider" Minimum="240" Maximum="640"
                                TickFrequency="20"/>

                        <TextBlock Classes="section" Text="PAPER"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Paper grid"/>
                                    <Border Classes="qmark" ToolTip.Tip="Faint lines or dots drawn on the page behind your notes: ruled lines like a notebook, squared grid, or dots. Individual pages can pick their own."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="PageGridBox" Grid.Column="1" Width="120" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Snap to grid"/>
                                    <Border Classes="qmark" ToolTip.Tip="While moving or resizing a note box, it jumps to line up with an invisible grid instead of landing anywhere."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GridSnap, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Create notes with double-click"/>
                                    <Border Classes="qmark" ToolTip.Tip="Off: clicking once on empty paper starts a new note box. On: you need to click twice, so a stray click does not start one by accident."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding DoubleClickCreate, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Rounded PDF corners"/>
                                    <Border Classes="qmark" ToolTip.Tip="When a page shows a PDF, the sheet's corners are gently rounded to match the rest of the app. Turn this off if you prefer sharp, square corners."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RoundedPdfCorners, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="EditorPanel" Spacing="6" IsVisible="False">
                        <TextBlock Classes="section" Text="CARET" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Caret color"/>
                                    <Border Classes="qmark" ToolTip.Tip="The color of the blinking line that shows where you are about to type. Leave it blank to use the app's highlight color instead."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBox x:Name="CaretColorBox" Classes="field" Grid.Column="1" Width="110" FontSize="12.5"
                                     PlaceholderText="#RRGGBB" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Caret width"/>
                                <Border Classes="qmark" ToolTip.Tip="How thick the blinking typing line looks."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="CaretWidthValue" Grid.Column="1" Classes="hint" Text="1.6"/>
                        </Grid>
                        <Slider x:Name="CaretWidthSlider" Minimum="1" Maximum="3"
                                TickFrequency="0.1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Caret blinks"/>
                                    <Border Classes="qmark" ToolTip.Tip="Turn off to keep the typing line steady instead of blinking. It still glides smoothly as you type."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CaretBlink, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="WRITING"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Quick highlight color"/>
                                    <Border Classes="qmark" ToolTip.Tip="The color used when you press Ctrl+Shift+H to highlight text."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="HighlightChoices" Grid.Column="1" Orientation="Horizontal"
                                        Spacing="6" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Date &amp; time format"/>
                                    <Border Classes="qmark" ToolTip.Tip="How the date and time look when you press Ctrl+Shift+T to insert them into your writing."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="DateFormatBox" Grid.Column="1" Width="170" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="TEXT DEFAULTS"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Note font"/>
                                    <Border Classes="qmark" ToolTip.Tip="The typeface used for plain text that has not been given its own font."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="EditorFontBox" Grid.Column="1" Width="170" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Note text size"/>
                                <Border Classes="qmark" ToolTip.Tip="The default size of your writing. You can still make individual text bigger or smaller from the toolbar."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="EditorFontSizeValue" Grid.Column="1" Classes="label" Text="15"/>
                        </Grid>
                        <Slider x:Name="EditorFontSizeSlider" Minimum="11" Maximum="24"
                                TickFrequency="1"/>

                        <TextBlock Classes="section" Text="SPACING"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Line spacing"/>
                                <Border Classes="qmark" ToolTip.Tip="How much empty space sits between lines of text within the same paragraph."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="LineSpacingValue" Grid.Column="1" Classes="hint" Text="1.0×"/>
                        </Grid>
                        <Slider x:Name="LineSpacingSlider" Minimum="1" Maximum="1.8"
                                TickFrequency="0.1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Paragraph spacing"/>
                                <Border Classes="qmark" ToolTip.Tip="How much empty space sits between one paragraph and the next."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="ParaSpacingValue" Grid.Column="1" Classes="hint" Text="1.0×"/>
                        </Grid>
                        <Slider x:Name="ParaSpacingSlider" Minimum="0.5" Maximum="3"
                                TickFrequency="0.25"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="List indent"/>
                                <Border Classes="qmark" ToolTip.Tip="How far bullet points and numbered items are pushed in from the edge of the note."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="IndentScaleValue" Grid.Column="1" Classes="hint" Text="1.0×"/>
                        </Grid>
                        <Slider x:Name="IndentScaleSlider" Minimum="0.7" Maximum="2"
                                TickFrequency="0.1"/>

                        <TextBlock Classes="section" Text="SMART INPUT"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Smart lists"/>
                                    <Border Classes="qmark" ToolTip.Tip="Typing '1. ', '- ' or '* ' at the start of a line turns it into a real bulleted or numbered list automatically."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SmartLists, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Classes="section" Text="TOOLBAR PALETTES"/>
                        <Grid ColumnDefinitions="90,*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Text colors"/>
                                <Border Classes="qmark" ToolTip.Tip="The row of color swatches offered when you pick a text color from the toolbar. Right-click a swatch to remove it, or add your own with the code box."><TextBlock/></Border>
                            </StackPanel>
                            <WrapPanel x:Name="TextPaletteChips" Grid.Column="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBox x:Name="TextPaletteHexBox" Classes="field" Width="96" FontSize="12" PlaceholderText="#RRGGBB"/>
                                <Button x:Name="TextPaletteReset" Classes="secondary" Content="Reset"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="90,*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Highlights"/>
                                <Border Classes="qmark" ToolTip.Tip="The row of color swatches offered when you pick a highlight color from the toolbar. Right-click a swatch to remove it, or add your own with the code box."><TextBlock/></Border>
                            </StackPanel>
                            <WrapPanel x:Name="HighlightPaletteChips" Grid.Column="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBox x:Name="HighlightPaletteHexBox" Classes="field" Width="96" FontSize="12" PlaceholderText="#RRGGBB"/>
                                <Button x:Name="HighlightPaletteReset" Classes="secondary" Content="Reset"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ShortcutsPanel" Spacing="6" IsVisible="False">
                        <TextBlock Classes="section" Text="CUSTOM SHORTCUTS" Margin="0,4,0,2"/>
                        <TextBlock Classes="hint" Text="Click a shortcut, then press the keys you want instead. Press Backspace while choosing to go back to the normal one, or Esc to keep what you have."/>
                        <StackPanel x:Name="ShortcutEditRows" Spacing="4" Margin="0,4,0,0"/>
                        <Button x:Name="ResetShortcutsBtn" Classes="secondary" Content="Reset all shortcuts"
                                HorizontalAlignment="Left" Margin="0,4,0,0"/>

                        <TextBlock Classes="section" Text="FIXED SHORTCUTS"/>
                        <StackPanel x:Name="ShortcutRows" Spacing="2" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="FontsPanel" Spacing="6" IsVisible="False">
                        <TextBlock Classes="section" Text="FONT MENU" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Show all installed fonts"/>
                                    <Border Classes="qmark" ToolTip.Tip="Offers every font installed on this computer instead of the short recommended list. The menu gets much longer."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ExtendedFonts, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="GET MORE FONTS"/>
                            <Border Classes="qmark" Margin="6,14,0,4" ToolTip.Tip="Search free fonts from Google Fonts and Fontshare, then download them straight into Lumenotepad. They are saved in the app's own folder — nothing is installed into Windows, and no account is needed."><TextBlock/></Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FontSearchBox" Classes="field" Grid.Column="0"
                                     PlaceholderText="Font name, e.g. Lobster or Satoshi"/>
                            <Button x:Name="FontSearchBtn" Grid.Column="1" Theme="{StaticResource LumenButton}"
                                    Content="Search" FontSize="13" VerticalAlignment="Stretch"/>
                            <Button x:Name="FontBrowseBtn" Grid.Column="2" Theme="{StaticResource LumenButtonGray}"
                                    Content="Browse all…" FontSize="13" VerticalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock x:Name="FontSearchStatus" Classes="hint" IsVisible="False" Margin="0,2,0,0"/>
                        <StackPanel x:Name="FontResults" Spacing="6" Margin="0,2,0,0"/>

                        <TextBlock Classes="section" Text="OFFERED FONTS"/>
                        <!-- A bounded Height still virtualizes the list inside the outer ScrollViewer
                             (which measures with infinite height) — without one, all-installed mode
                             realizes 500+ typeface previews at once. The bound is now set from
                             code-behind (PrefsScroll.SizeChanged) so it tracks the window's viewport
                             instead of a fixed 300px. Keep it bounded. -->
                        <ListBox x:Name="FontsList" Classes="fontcheck" Margin="0,4,0,0"
                                 Background="Transparent" BorderThickness="0" Padding="0"/>
                    </StackPanel>

                    <StackPanel x:Name="BulletsPanel" Spacing="6" IsVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="BULLET COLORS" Margin="0,4,0,2"/>
                            <Border Classes="qmark" Margin="6,2,0,0" ToolTip.Tip="Each row below is a bullet style. Click its color swatch to change the color that style uses everywhere."><TextBlock/></Border>
                        </StackPanel>
                        <StackPanel x:Name="BulletColorRows" Spacing="4" Margin="0,4,0,0"/>

                        <TextBlock Classes="section" Text="NUMBERED LISTS"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Bold numbers"/>
                                <Border Classes="qmark" ToolTip.Tip="How the numbers in numbered lists look. 'Match text' copies whatever the line's text looks like."><TextBlock/></Border>
                            </StackPanel>
                            <ComboBox x:Name="NumBoldBox" Grid.Column="1" Width="130"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Italic numbers"/>
                                <Border Classes="qmark" ToolTip.Tip="Whether the numbers in numbered lists lean in italics. 'Match text' copies whatever the line's text looks like."><TextBlock/></Border>
                            </StackPanel>
                            <ComboBox x:Name="NumItalicBox" Grid.Column="1" Width="130"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Underlined numbers"/>
                                <Border Classes="qmark" ToolTip.Tip="Whether the numbers in numbered lists are underlined. 'Match text' copies whatever the line's text looks like."><TextBlock/></Border>
                            </StackPanel>
                            <ComboBox x:Name="NumUnderlineBox" Grid.Column="1" Width="130"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Struck-through numbers"/>
                                <Border Classes="qmark" ToolTip.Tip="Whether the numbers in numbered lists have a line through them. 'Match text' copies whatever the line's text looks like."><TextBlock/></Border>
                            </StackPanel>
                            <ComboBox x:Name="NumStrikeBox" Grid.Column="1" Width="130"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Spacing="6" IsVisible="False">
                        <!-- Identity block, then the update + build-details actions. Populated in the
                             code-behind so the version, packaging and OS facts come from AppInfo. -->
                        <Grid ColumnDefinitions="Auto,*" Margin="2,0,0,16">
                            <Image Source="avares://Lumenotepad/Assets/lumenotepad-icon-256.png"
                                   Width="60" Height="60" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AboutName" FontSize="25" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="AboutTagline" FontSize="12.5" TextWrapping="Wrap"
                                           Margin="0,2,0,6"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="AboutVersion" FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,6">
                            <Button x:Name="AboutUpdateBtn" Content="Check for updates" FontSize="12.5"
                                    Padding="16,9"/>
                            <Button x:Name="AboutCopyBtn" Content="Copy build details" FontSize="12.5"
                                    Padding="14,9"/>
                        </StackPanel>

                        <TextBlock Classes="section" Text="UPDATES"/>
                        <Grid x:Name="AboutAutoRow" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Check on launch"/>
                                <Border Classes="qmark" ToolTip.Tip="Quietly looks for a newer version each time the app starts. It never installs anything on its own - you always get to choose."><TextBlock/></Border>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="AboutUpdateNote" Classes="hint" TextWrapping="Wrap"/>

                        <TextBlock Classes="section" Text="BUILD"/>
                        <SelectableTextBlock x:Name="AboutDetails" FontSize="12" TextWrapping="Wrap"
                                             FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Classes="section" Text="CREDITS"/>
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Built with Avalonia and .NET. Page rendering uses Skia and HarfBuzz; PDF pages are rasterized with native PDFium. Icons are derived from Microsoft's MIT-licensed fluentui-system-icons. Full attributions are in THIRD-PARTY-NOTICES.md."/>
                    </StackPanel>

                    <StackPanel x:Name="DataPanel" Spacing="6" IsVisible="False">
                        <TextBlock Classes="section" Text="STORAGE" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Data folder"/>
                                    <Border Classes="qmark" ToolTip.Tip="Where Lumenotepad keeps your notebooks and pages on this computer. Click Open to see it in File Explorer."><TextBlock/></Border>
                                </StackPanel>
                                <TextBlock x:Name="DataFolderText" Classes="hint" Text="—"/>
                            </StackPanel>
                            <Button x:Name="OpenDataBtn" Classes="secondary" Grid.Column="1" Content="Open" VerticalAlignment="Center"
                                    Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Workspace size"/>
                                <Border Classes="qmark" ToolTip.Tip="How much disk space all your notebooks and pages currently take up."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="WorkspaceSizeText" Grid.Column="1" Classes="label" Text="—"/>
                        </Grid>

                        <TextBlock Classes="section" Text="AUTOMATIC BACKUP"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Backup folder"/>
                                    <Border Classes="qmark" ToolTip.Tip="Where your automatic backup copies are saved. Pick a folder outside this computer's app folder — for example a cloud-synced one."><TextBlock/></Border>
                                </StackPanel>
                                <TextBlock x:Name="BackupFolderText" Classes="hint" Text="Not set — automatic backups are off."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="BackupFolderBtn" Classes="secondary" Content="Choose…"
                                        Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                                <Button x:Name="BackupClearBtn" Classes="secondary" Content="Clear"
                                        Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="How often"/>
                                    <Border Classes="qmark" ToolTip.Tip="How often Lumenotepad checks whether it is time to make a new automatic backup. It only checks once, right when the app starts."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="BackupEveryBox" Grid.Column="1" Width="140" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="label" Text="Keep the newest"/>
                                <Border Classes="qmark" ToolTip.Tip="How many automatic backups Lumenotepad keeps. Once it reaches this number, the oldest backup is removed to make room for a new one."><TextBlock/></Border>
                            </StackPanel>
                            <TextBlock x:Name="BackupKeepValue" Grid.Column="1" Classes="label" Text="5"/>
                        </Grid>
                        <Slider x:Name="BackupKeepSlider" Minimum="1" Maximum="20"
                                TickFrequency="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Back up now"/>
                                    <Border Classes="qmark" ToolTip.Tip="Makes a backup copy of everything right away, instead of waiting for the automatic schedule."><TextBlock/></Border>
                                </StackPanel>
                                <TextBlock x:Name="LastBackupText" Classes="hint" Text="Never backed up."/>
                            </StackPanel>
                            <Button x:Name="BackupNowBtn" Classes="secondary" Grid.Column="1" Content="Back up now" VerticalAlignment="Center"
                                    Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                        </Grid>

                        <TextBlock Classes="section" Text="IMPORT &amp; EXPORT"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Export all notebooks to Markdown"/>
                                    <Border Classes="qmark" ToolTip.Tip="Saves a copy of every notebook as plain text files you can open in other programs, organized into folders by notebook, section and page."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="ExportBtn" Classes="secondary" Grid.Column="1" Content="Export…" VerticalAlignment="Center"
                                    Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Import a text file"/>
                                    <Border Classes="qmark" ToolTip.Tip="Adds the contents of a text file to the section you currently have open, as a brand new page."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="ImportBtn" Classes="secondary" Grid.Column="1" Content="Import…" VerticalAlignment="Center"
                                    Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                        </Grid>
                        <TextBlock x:Name="DataStatusText" Classes="hint" Margin="0,8,0,0" Text=""/>

                        <TextBlock Classes="section" Text="MAINTENANCE"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Reset settings"/>
                                    <Border Classes="qmark" ToolTip.Tip="Puts every preference on this Preferences window back to how it was when you first installed Lumenotepad. Your notebooks and notes are not touched."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="ResetBtn" Classes="secondary" Grid.Column="1" Content="Reset…" VerticalAlignment="Center"
                                    Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="label" Text="Lock advanced settings"/>
                                    <Border Classes="qmark" ToolTip.Tip="Hides the Fonts, Bullets &amp; numbers, and Data &amp; tools categories again, behind the same confirmation you saw the first time."><TextBlock/></Border>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="RelockBtn" Grid.Column="1" Content="Lock" VerticalAlignment="Center"
                                    Theme="{StaticResource LumenButton}" FontSize="12" Padding="12,5"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
    <!-- top-most: thin edge/corner grips that make the chromeless window resizable -->
    <controls:WindowResizeBorder/>
    </Grid>
</Window>
