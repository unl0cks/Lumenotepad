<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Lumenotepad.Views"
             x:Class="Lumenotepad.Views.PdfViewer">

    <UserControl.Styles>
        <Style Selector="ToggleButton.tool">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.tool:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.sep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,6,16,8" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <ToggleButton x:Name="HighlightTool" Classes="tool" Content="Highlight" ToolTip.Tip="Drag over the page to highlight"/>
                <ToggleButton x:Name="NoteTool" Classes="tool" Content="Note" ToolTip.Tip="Double-click the page to add a sticky note"/>
                <ToggleButton x:Name="TextTool" Classes="tool" Content="Text" ToolTip.Tip="Double-click the page to write text on it"/>
                <ToggleButton x:Name="ArrowTool" Classes="tool" Content="Arrow" ToolTip.Tip="Drag to draw an arrow"/>
                <Button x:Name="ArrowOptsBtn" Classes="mini" Content="&#x25BE;"
                        ToolTip.Tip="Arrow style: curved, arrowhead shape and size"/>
                <Border Classes="sep"/>
                <ToggleButton x:Name="SnapBtn" Classes="tool" Content="Snap"
                              ToolTip.Tip="Snap notes, text, highlights, and arrows to a grid"/>
                <Border Classes="sep"/>
                <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                <Border Classes="sep"/>
                <Button x:Name="ZoomOut" Classes="mini" Content="&#x2212;" ToolTip.Tip="Zoom out"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" Width="42" TextAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button x:Name="ZoomIn" Classes="mini" Content="+" ToolTip.Tip="Zoom in"/>
                <Border Classes="sep"/>
                <Button x:Name="ExportBtn" Classes="pill" Content="Save a copy…"
                        ToolTip.Tip="Save a new PDF with your highlights, notes, text, and arrows baked in"/>
                <Border Classes="sep"/>
                <TextBlock x:Name="StatusLabel" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <v:FormatToolbar x:Name="FmtBar" DockPanel.Dock="Top" IsEnabled="False" Opacity="0.45"/>

        <ScrollViewer x:Name="PagesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PagesHost" Spacing="16" Margin="16" HorizontalAlignment="Center"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
