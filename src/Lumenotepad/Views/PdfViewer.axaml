<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumenotepad.Views.PdfViewer">

    <UserControl.Styles>
        <Style Selector="ToggleButton.tool">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.tool:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.sep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- whole-box text formatting (applies to the selected note/text) -->
        <Style Selector="ToggleButton.fmt">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.fmt:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,6,16,8" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <ToggleButton x:Name="SelectTool" Classes="tool" Content="Select" ToolTip.Tip="Select, move, or delete annotations"/>
                <ToggleButton x:Name="HighlightTool" Classes="tool" Content="Highlight" ToolTip.Tip="Drag over the page to highlight"/>
                <ToggleButton x:Name="NoteTool" Classes="tool" Content="Note" ToolTip.Tip="Add a sticky note"/>
                <ToggleButton x:Name="TextTool" Classes="tool" Content="Text" ToolTip.Tip="Write text over the page"/>
                <ToggleButton x:Name="ArrowTool" Classes="tool" Content="Arrow" ToolTip.Tip="Drag to draw an arrow"/>
                <Border Classes="sep"/>
                <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"/>
                <Border Classes="sep"/>
                <StackPanel x:Name="FmtGroup" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsEnabled="False">
                    <ToggleButton x:Name="FmtBold" Classes="fmt" ToolTip.Tip="Bold"><TextBlock Text="B" FontWeight="Bold"/></ToggleButton>
                    <ToggleButton x:Name="FmtItalic" Classes="fmt" ToolTip.Tip="Italic"><TextBlock Text="I" FontStyle="Italic"/></ToggleButton>
                    <ToggleButton x:Name="FmtUnder" Classes="fmt" ToolTip.Tip="Underline"><TextBlock Text="U" TextDecorations="Underline"/></ToggleButton>
                    <ToggleButton x:Name="FmtStrike" Classes="fmt" ToolTip.Tip="Strikethrough"><TextBlock Text="S" TextDecorations="Strikethrough"/></ToggleButton>
                    <ToggleButton x:Name="FmtBullet" Classes="fmt" ToolTip.Tip="Bullet list"><TextBlock Text="&#8226;"/></ToggleButton>
                </StackPanel>
                <Border Classes="sep"/>
                <Button x:Name="ZoomOut" Classes="mini" Content="&#x2212;" ToolTip.Tip="Zoom out"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" Width="42" TextAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button x:Name="ZoomIn" Classes="mini" Content="+" ToolTip.Tip="Zoom in"/>
                <Border Classes="sep"/>
                <TextBlock x:Name="StatusLabel" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="PagesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PagesHost" Spacing="16" Margin="16" HorizontalAlignment="Center"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
