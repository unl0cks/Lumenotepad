<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lumenotepad.Views.FontBrowserWindow"
        Title="Browse fonts"
        Width="1280" Height="880" MinWidth="820" MinHeight="600"
        WindowDecorations="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextRenderingMode="Antialias"
        Background="{DynamicResource WindowSurfaceBrush}"
        TransparencyLevelHint="AcrylicBlur, Transparent, None">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="ToggleButton.style">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.style:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FrameBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.chip:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ListBox#FontList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox#FontList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#FontList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.fontcard">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.14"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.fontcard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="38" ColumnDefinitions="*,Auto" x:Name="BrowserTitleBar" Background="Transparent">
            <TextBlock Text="Browse fonts" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button x:Name="CloseBtn" Grid.Column="1" Theme="{StaticResource CloseCaptionButton}"
                    Content="&#xE8BB;" VerticalAlignment="Center" Margin="0,0,3,0"/>
        </Grid>

        <StackPanel x:Name="ListHeader" DockPanel.Dock="Top" Margin="22,4,22,10" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox x:Name="SearchBox" Grid.Column="0" MinHeight="34"
                         Theme="{StaticResource RoundedFieldTextBox}" FontSize="13"
                         PlaceholderText="Search fonts by name…"/>
                <TextBlock x:Name="CountLabel" Grid.Column="1" Classes="section"
                           VerticalAlignment="Center" Text=""/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                <TextBlock Grid.Column="0" Text="Preview" Classes="section" VerticalAlignment="Center"/>
                <TextBox x:Name="PreviewBox" Grid.Column="1" MinHeight="34"
                         Theme="{StaticResource RoundedFieldTextBox}" FontSize="13"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="A" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="SizeSlider" Width="120" Minimum="16" Maximum="80" Value="30" VerticalAlignment="Center"/>
                    <TextBlock Text="A" FontSize="19" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <ToggleButton x:Name="BoldToggle" Classes="style" ToolTip.Tip="Bold">
                        <TextBlock Text="B" FontWeight="Bold"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicToggle" Classes="style" ToolTip.Tip="Italic">
                        <TextBlock Text="I" FontStyle="Italic"/>
                    </ToggleButton>
                    <ToggleButton x:Name="UnderToggle" Classes="style" ToolTip.Tip="Underline">
                        <TextBlock Text="U" TextDecorations="Underline"/>
                    </ToggleButton>
                    <ToggleButton x:Name="StrikeToggle" Classes="style" ToolTip.Tip="Strikethrough">
                        <TextBlock Text="S" TextDecorations="Strikethrough"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <WrapPanel x:Name="CategoryChips"/>
        </StackPanel>

        <TextBlock x:Name="StatusLabel" DockPanel.Dock="Top" Margin="22,0,22,8"
                   Classes="section" TextWrapping="Wrap" IsVisible="False"/>

        <ListBox x:Name="FontList" Margin="16,0,16,14"
                 Background="Transparent" BorderThickness="0"
                 SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>

    <Grid x:Name="DetailOverlay" Margin="0,38,0,0" IsVisible="False"
          Background="{DynamicResource WindowSurfaceBrush}">
        <DockPanel Margin="22,10,22,16">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Button x:Name="DetailBackBtn" Theme="{StaticResource IconButton}" Width="34" Height="34"
                        FontFamily="{StaticResource IconFont}" FontSize="15" Content="&#xE72B;"
                        ToolTip.Tip="Back to the list" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailName" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailCategory" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <Button x:Name="DetailInstallBtn" Grid.Column="2" Theme="{StaticResource LumenButton}"
                        Content="Install" FontSize="13" Padding="16,7" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border CornerRadius="10" Padding="16,12" Background="{DynamicResource ControlHoverBrush}"
                            BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="1">
                        <Image x:Name="DetailBigPreview" Height="46" Stretch="Uniform"
                               HorizontalAlignment="Left"/>
                    </Border>
                    <StackPanel x:Name="DetailCharGroups" Spacing="8"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
