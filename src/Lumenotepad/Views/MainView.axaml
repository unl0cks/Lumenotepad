<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumenotepad.Views.MainView"
             xmlns:vm="using:Lumenotepad.ViewModels"
             xmlns:models="using:Lumenotepad.Models"
             xmlns:v="using:Lumenotepad.Views"
             xmlns:editor="using:Lumenotepad.Editor"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <x:Double x:Key="NbCardWidth">196</x:Double>
        <x:Double x:Key="NbCardHeight">132</x:Double>
        <x:Double x:Key="NbCardCellWidth">224</x:Double>
        <x:Double x:Key="NbCardCellHeight">162</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox.rename">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox.rename /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.rename:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A808080"/>
        </Style>
        <Style Selector="TextBox.rename:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#26808080"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ListBox.rail ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.rail ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.rail ListBoxItem Border.railchip">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.rail ListBoxItem:selected Border.railchip">
            <Setter Property="BoxShadow" Value="{ReflectionBinding Color, Converter={x:Static v:Converters.GlowShadow}}"/>
        </Style>
        <Style Selector="ListBox.pages ListBoxItem">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="7,3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>
        <Style Selector="ListBox.pages ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource AccentGlowShadow}"/>
        </Style>
        <Style Selector="ListBox.sections ListBoxItem">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3,4,5,4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>
        <Style Selector="ListBox.sections ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource AccentGlowShadow}"/>
        </Style>
        <Style Selector="Border.nbcard">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.chipfx">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ItemsControl.glossy Border.chipfx">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ListBox.glossy ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
        </Style>
        <Style Selector="Border.recentchip">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.recentchip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ItemsControl.rearrange Border.nbcard">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ItemsControl.rearrange Border.wigglewrap">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:0.3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-1.2"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RotateTransform.Angle" Value="1.2"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-1.2"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ItemsControl.flat Border.cardfx">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox.flat Border.cardfx">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TextBox.inlineedit">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.inlineedit /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#26808080"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid x:Name="AppRoot" RowDefinitions="38,*">

        <Border x:Name="GlassTintVeil" Grid.RowSpan="2" IsVisible="False" IsHitTestVisible="False"/>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" x:Name="TitleBar" Background="{DynamicResource FrameBackgroundBrush}">
            <StackPanel x:Name="TitleLeft" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="9">
                <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="#04213F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Lumenotepad" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="PrefsBtn" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE713;"
                        IsVisible="{Binding !IsHomeVisible}" ToolTip.Tip="Preferences"/>
                <Button x:Name="HomeBtn" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE80F;"
                        IsVisible="{Binding !IsHomeVisible}"
                        Command="{Binding GoHomeCommand}" ToolTip.Tip="All notebooks"/>
                <Button x:Name="RailToggle" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE8A1;"
                        IsVisible="{Binding !IsHomeVisible}"
                        Command="{Binding ToggleRailCommand}" ToolTip.Tip="Show / hide notebooks"/>
                <Button x:Name="PagesToggle" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE8A5;"
                        IsVisible="{Binding !IsHomeVisible}"
                        Command="{Binding TogglePagesCommand}" ToolTip.Tip="Show / hide pages"/>
            </StackPanel>

            <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal" Margin="0,0,3,0">
                <Button x:Name="MinBtn" Theme="{StaticResource CaptionButton}" Content="&#xE921;"/>
                <Button x:Name="MaxBtn" Theme="{StaticResource CaptionButton}" Content="&#xE922;"/>
                <Button x:Name="CloseBtn" Theme="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"/>
            </StackPanel>
        </Grid>

        <Panel Grid.Row="1">

        <ScrollViewer x:Name="HomeHost" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource CanvasBackgroundBrush}">
            <StackPanel Margin="48,26,48,32" Spacing="20" MaxWidth="1560">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Greeting}" FontSize="12.5"
                                   Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                        <TextBlock Text="Notebooks" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CanvasTextBrush}"/>
                        <TextBlock Text="{Binding HomeSubtitle}"
                                   FontSize="12.5" Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="RearrangeBtn" Theme="{StaticResource IconButton}" Width="34" Height="34"
                                FontSize="15" FontFamily="{StaticResource IconFont}" Content="&#xE76F;"
                                Foreground="{DynamicResource CanvasTextBrush}"
                                ToolTip.Tip="Rearrange notebooks (drag them around, click again when done)"/>
                        <Button x:Name="SortBtn" Theme="{StaticResource IconButton}" Width="34" Height="34"
                                FontSize="15" FontFamily="{StaticResource IconFont}" Content="&#xE8CB;"
                                Foreground="{DynamicResource CanvasTextBrush}" ToolTip.Tip="Sort notebooks"/>
                        <Button x:Name="NewNotebookBtn"
                                Theme="{StaticResource LumenButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="New notebook" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="8" IsVisible="{Binding HasRecents}">
                    <TextBlock Text="JUMP BACK IN" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                    <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentPages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentPage">
                                <Border Classes="recentchip" Margin="5,5,13,13" CornerRadius="10"
                                        Background="{DynamicResource CanvasChipBrush}"
                                        BorderBrush="{DynamicResource CanvasChipBorderBrush}" BorderThickness="1"
                                        Cursor="Hand">
                                    <Panel>
                                        <Border Classes="chipfx" CornerRadius="9" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                    <GradientStop Offset="0" Color="#21FFFFFF"/>
                                                    <GradientStop Offset="0.5" Color="#00FFFFFF"/>
                                                    <GradientStop Offset="1" Color="#14000000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="12,8">
                                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                    Background="{Binding Color, Converter={x:Static v:Converters.HexBrush}}"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource CanvasTextBrush}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                           Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl x:Name="HomeCards" ItemsSource="{Binding Notebooks}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Notebook">
                            <Panel Width="{DynamicResource NbCardCellWidth}" Height="{DynamicResource NbCardCellHeight}" Margin="0,0,2,2">
                                <Border Width="{DynamicResource NbCardWidth}" Height="{DynamicResource NbCardHeight}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="14" Background="#01000000" IsHitTestVisible="False"
                                        BoxShadow="0 2 10 0 #59000000"/>
                                <Border Classes="wigglewrap"
                                        Width="{DynamicResource NbCardCellWidth}" Height="{DynamicResource NbCardCellHeight}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                                <Border Classes="nbcard"
                                        Width="{DynamicResource NbCardWidth}" Height="{DynamicResource NbCardHeight}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="14" Cursor="Hand" BorderThickness="1"
                                        Background="{Binding Color, Converter={x:Static v:Converters.HexBrush}}"
                                        BorderBrush="{Binding Color, Converter={x:Static v:Converters.CoverBorder}}">
                                    <Panel>
                                        <Border CornerRadius="13"
                                                Background="{Binding CoverPath, Converter={x:Static v:Converters.CoverImage}}"/>
                                        <Border Classes="cardfx" CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="#38FFFFFF">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                    <GradientStop Offset="0" Color="#2BFFFFFF"/>
                                                    <GradientStop Offset="0.45" Color="#00FFFFFF"/>
                                                    <GradientStop Offset="1" Color="#26000000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="13">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                    <GradientStop Offset="0.45" Color="#00000000"/>
                                                    <GradientStop Offset="0.70" Color="#38000000"/>
                                                    <GradientStop Offset="1" Color="#73000000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Panel>
                                            <TextBlock Text="{Binding Name, Converter={x:Static v:Converters.Initials}}"
                                                       FontSize="30" FontWeight="Bold" Foreground="#59FFFFFF"
                                                       Margin="16,12,0,0"
                                                       IsVisible="{Binding CoverPath, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                                            <StackPanel Spacing="2" Margin="14,0,14,10" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ., Converter={x:Static v:Converters.NotebookStats}}"
                                                           FontSize="11" Foreground="#CCFFFFFF"/>
                                            </StackPanel>
                                        </Panel>
                                    </Panel>
                                </Border>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Canvas x:Name="DragLayer" IsHitTestVisible="False" IsVisible="{Binding IsHomeVisible}" ClipToBounds="False"/>

        <Button x:Name="HomePrefsBtn" Theme="{StaticResource LumenButton}"
                IsVisible="{Binding IsHomeVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Preferences" FontSize="13"/>
            </StackPanel>
        </Button>

        <DockPanel x:Name="BodyDock" IsVisible="False">
        <v:FormatToolbar x:Name="Toolbar" DockPanel.Dock="Top"/>
        <Grid ColumnDefinitions="Auto,Auto,Auto,*">

            <Border x:Name="RailPanel" Grid.Column="0" Width="64" ClipToBounds="True"
                    Background="{DynamicResource FrameBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,10">
                    <Button x:Name="RailAddBtn" DockPanel.Dock="Bottom" Theme="{StaticResource IconButton}" Width="40" Height="40"
                            HorizontalAlignment="Center" Margin="0,8,0,0" FontFamily="{StaticResource IconFont}"
                            Content="&#xE710;" ToolTip.Tip="New notebook"/>
                    <ListBox x:Name="NotebooksList" Classes="rail" Background="Transparent" BorderThickness="0"
                             Padding="0,8" ClipToBounds="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.AllowAutoHide="True"
                             ItemsSource="{Binding Notebooks}"
                             SelectedItem="{Binding SelectedNotebook, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Notebook">
                                    <Border Classes="railchip" Width="36" Height="36" CornerRadius="11" BorderThickness="1"
                                            Background="{Binding Color, Converter={x:Static v:Converters.HexBrush}}"
                                            BorderBrush="{Binding Color, Converter={x:Static v:Converters.CoverBorder}}"
                                            ToolTip.Tip="{Binding Name}">
                                        <Panel>
                                            <Border Classes="cardfx" CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                        <GradientStop Offset="0" Color="#2EFFFFFF"/>
                                                        <GradientStop Offset="0.5" Color="#00FFFFFF"/>
                                                        <GradientStop Offset="1" Color="#2E000000"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding Name, Converter={x:Static v:Converters.Initials}}"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="SectionsSidebar" Grid.Column="1" Width="152" IsVisible="False" ClipToBounds="True"
                    Background="{DynamicResource FrameBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,12,10,8">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="2,0,0,6">
                        <TextBlock Text="Sections" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="SideSectionsAddBtn" Grid.Column="1" Theme="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                FontFamily="{StaticResource IconFont}" Content="&#xE710;" ToolTip.Tip="Add / rearrange / open sections"/>
                        <Button x:Name="SideRenameSectionBtn" Grid.Column="2" Theme="{StaticResource IconButton}" Width="24" Height="24"
                                FontSize="12" FontFamily="{StaticResource IconFont}" Content="&#xE70F;"
                                ToolTip.Tip="Rename section"/>
                    </Grid>
                    <ListBox x:Name="SectionsSidebarList" Classes="sections" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemsSource="{Binding SelectedNotebook.Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Section">
                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="PagesPanel" Grid.Column="2" Width="224" ClipToBounds="True"
                    Background="{DynamicResource FrameBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="0,0,1,0">
              <Panel>
                <DockPanel Margin="12,12,12,0">

                    <TextBox x:Name="NotebookName" DockPanel.Dock="Top" Theme="{StaticResource RoundedFieldTextBox}"
                             Classes="rename" FontSize="16" FontWeight="SemiBold"
                             PlaceholderText="Notebook" Text="{Binding SelectedNotebook.Name, Mode=TwoWay}"/>

                    <Grid x:Name="SectionsHeader" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,4">
                        <TextBlock Text="Sections" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="SectionsAddBtn" Grid.Column="2" Theme="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                FontFamily="{StaticResource IconFont}" Content="&#xE710;" ToolTip.Tip="Add / rearrange / open sections"/>
                        <Button x:Name="RenameSectionBtn" Grid.Column="3" Theme="{StaticResource IconButton}" Width="24" Height="24"
                                FontSize="12" FontFamily="{StaticResource IconFont}" Content="&#xE70F;"
                                ToolTip.Tip="Rename section"/>
                    </Grid>
                    <ListBox x:Name="SectionsList" DockPanel.Dock="Top" Classes="sections" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemsSource="{Binding SelectedNotebook.Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Section">
                                <Panel>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsEditing}"/>
                                    <TextBox Classes="inlineedit" Theme="{StaticResource RoundedFieldTextBox}"
                                             FontSize="12.5" Text="{Binding Name, Mode=TwoWay}"
                                             IsVisible="{Binding IsEditing}"/>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,4">
                        <TextBlock Text="Pages" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="PagesAddBtn" Grid.Column="2" Theme="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                FontFamily="{StaticResource IconFont}" Content="&#xE710;" ToolTip.Tip="Add / rearrange / open pages"/>
                    </Grid>

                    <ListBox x:Name="PagesList" Classes="pages" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemsSource="{Binding SelectedSection.Pages}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Page">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Border x:Name="PagesResizeGrip" Width="5" HorizontalAlignment="Right"
                        Background="Transparent" Cursor="SizeWestEast"/>
              </Panel>
            </Border>

            <Panel Grid.Column="3">
            <Border x:Name="CanvasPlate" Background="{DynamicResource CanvasBackgroundBrush}"/>
            <Border x:Name="PageBoxSurface" Margin="14" CornerRadius="{DynamicResource RadiusPage}"
                    Background="{DynamicResource PaperBackgroundBrush}" BorderBrush="{DynamicResource PaperBorderBrush}" BorderThickness="1">
                <Panel>
                <Border x:Name="PaperTintVeil" CornerRadius="{DynamicResource RadiusPageInner}" IsVisible="False" IsHitTestVisible="False"/>
                <DockPanel x:Name="PageDock">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="26,22,26,0"
                          IsVisible="{Binding SelectedPage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBox x:Name="PageTitle" Classes="rename"
                                 Theme="{StaticResource RoundedFieldTextBox}"
                                 Foreground="{DynamicResource PaperTextBrush}"
                                 FontSize="26" FontWeight="SemiBold" PlaceholderText="Page title"
                                 Text="{Binding SelectedPage.Title, Mode=TwoWay}"/>
                        <Button x:Name="TagsBtn" Grid.Column="1" Theme="{StaticResource IconButton}"
                                Width="30" Height="30" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}" Content="&#xE8EC;"
                                ToolTip.Tip="Tagged notes"/>
                        <Button x:Name="HistoryBtn" Grid.Column="2" Theme="{StaticResource IconButton}"
                                Width="30" Height="30" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}" Content="&#xE81C;"
                                IsVisible="{Binding DeletedHistory}" ToolTip.Tip="Deleted containers"/>
                    </Grid>

                    <Border x:Name="MindmapBar" DockPanel.Dock="Top" IsVisible="False"
                            Margin="26,10,26,0" Padding="5,3" CornerRadius="9"
                            HorizontalAlignment="Left" UseLayoutRounding="True"
                            Background="{DynamicResource ControlHoverBrush}"
                            BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="1">
                        <StackPanel x:Name="MindmapBarContent" Orientation="Horizontal"
                                    Spacing="2" VerticalAlignment="Center"/>
                    </Border>

                    <Panel>
                        <ScrollViewer x:Name="CanvasScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Margin="16,12,16,16">
                            <LayoutTransformControl x:Name="CanvasZoomHost">
                                <editor:NoteCanvas x:Name="PageCanvas"/>
                            </LayoutTransformControl>
                        </ScrollViewer>
                        <Border x:Name="TagsPanel" IsVisible="False" Width="252"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,10,12,12"
                                CornerRadius="10" Background="#E8191B24"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <DockPanel Margin="12,10,12,12">
                                <TextBlock DockPanel.Dock="Top" Text="Tagged notes"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock DockPanel.Dock="Top" Text="Everything tagged in this notebook. Click one to jump to its page."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="TagsList" Spacing="6"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border x:Name="TrashPanel" IsVisible="False" Width="238"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,10,12,12"
                                CornerRadius="10" Background="#E8191B24"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <DockPanel Margin="12,10,12,12">
                                <TextBlock DockPanel.Dock="Top" Text="Deleted containers"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock DockPanel.Dock="Top" Text="Drag one onto the page to bring it back."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="TrashList" Spacing="6"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Panel>
                </DockPanel>
                <v:PdfViewer x:Name="PagePdfViewer" IsVisible="False" ClipToBounds="True"/>
                </Panel>
            </Border>
            </Panel>
        </Grid>
        </DockPanel>

        </Panel>
    </Grid>

    <Panel x:Name="RenameOverlay" IsVisible="False">
        <Border x:Name="RenameVeil" Background="#66000000"/>
        <Border x:Name="RenameCard" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12" Padding="20,16"
                Background="{DynamicResource MenuBackgroundBrush}"
                BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1"
                BoxShadow="0 12 44 0 #55000000">
            <StackPanel Spacing="10">
                <TextBlock x:Name="RenameTitle" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Text="RENAME"/>
                <TextBox x:Name="RenameBox" Theme="{StaticResource RoundedFieldTextBox}"
                         FontSize="20" Padding="10,7"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Enter to save  ·  Esc to cancel"/>
            </StackPanel>
        </Border>
    </Panel>
    </Panel>
</UserControl>
