<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumenotepad.Views.MainView"
             xmlns:vm="using:Lumenotepad.ViewModels"
             xmlns:models="using:Lumenotepad.Models"
             xmlns:v="using:Lumenotepad.Views"
             xmlns:editor="using:Lumenotepad.Editor"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- flat, borderless rename fields -->
        <Style Selector="TextBox.rename">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox.rename /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.rename:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>
        <Style Selector="TextBox.rename:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>
        <!-- rail chips -->
        <Style Selector="ListBox.rail ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- page rows -->
        <Style Selector="ListBox.pages ListBoxItem">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- section tabs -->
        <Style Selector="ListBox.sections ListBoxItem">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- homepage notebook cards. The SHADOW lives on a separate static underlay (see the card
             template): animated visuals get compositor layers clipped to their layout slot, so a
             shadow (or animated shadow) on the scaling card itself gets cut off on live GPU
             rendering — invisible in headless renders, very visible on the acrylic window. -->
        <Style Selector="Border.nbcard">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.nbcard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.035)"/>
        </Style>
        <!-- "Glossy accents" preference: top-lit gloss on chips + selected pills -->
        <Style Selector="Border.chipfx">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ItemsControl.glossy Border.chipfx">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ListBox.glossy ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
        </Style>
        <!-- "Jump back in" chips: NO scale hover — a transitioned transform gets a compositor
             layer clipped to the layout slot (the notebook-card lesson), cutting the chip's edge. -->
        <Style Selector="Border.recentchip">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.recentchip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Rearrange mode: Apple-style wiggle while cards are draggable -->
        <Style Selector="ItemsControl.rearrange Border.nbcard">
            <Setter Property="Cursor" Value="SizeAll"/>
            <Style.Animations>
                <Animation Duration="0:0:0.3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-1.1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RotateTransform.Angle" Value="1.1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-1.1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- "Flat covers" preference: the gloss overlays vanish, shadow + caption scrim stay -->
        <Style Selector="ItemsControl.flat Border.cardfx">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox.flat Border.cardfx">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- inline rename box (section tab) -->
        <Style Selector="TextBox.inlineedit">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.inlineedit /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="38,*">

        <!-- ============ Title bar ============ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" x:Name="TitleBar" Background="{DynamicResource FrameBackgroundBrush}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="9">
                <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="#04213F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Lumenotepad" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="PrefsBtn" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE713;"
                        IsVisible="{Binding !IsHomeVisible}" ToolTip.Tip="Preferences"/>
                <Button x:Name="HomeBtn" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE80F;"
                        IsVisible="{Binding !IsHomeVisible}"
                        Command="{Binding GoHomeCommand}" ToolTip.Tip="All notebooks"/>
                <Button x:Name="RailToggle" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE8A1;"
                        IsVisible="{Binding !IsHomeVisible}"
                        Command="{Binding ToggleRailCommand}" ToolTip.Tip="Show / hide notebooks"/>
                <Button x:Name="PagesToggle" Theme="{StaticResource IconButton}" Width="34" Height="34" FontSize="15"
                        FontFamily="{StaticResource IconFont}" Content="&#xE8A5;"
                        IsVisible="{Binding !IsHomeVisible}"
                        Command="{Binding TogglePagesCommand}" ToolTip.Tip="Show / hide pages"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,3,0">
                <Button x:Name="MinBtn" Theme="{StaticResource CaptionButton}" Content="&#xE921;"/>
                <Button x:Name="MaxBtn" Theme="{StaticResource CaptionButton}" Content="&#xE922;"/>
                <Button x:Name="CloseBtn" Theme="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"/>
            </StackPanel>
        </Grid>

        <!-- ============ Body: homepage gallery OR the editor (toolbar + rail | nav | canvas) ============ -->
        <Panel Grid.Row="1">

        <!-- Homepage: the notebook gallery -->
        <ScrollViewer x:Name="HomeHost" IsVisible="{Binding IsHomeVisible}" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource CanvasBackgroundBrush}">
            <StackPanel Margin="36,26,36,32" Spacing="20" MaxWidth="1100">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Greeting}" FontSize="12.5"
                                   Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                        <TextBlock Text="Notebooks" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CanvasTextBrush}"/>
                        <TextBlock Text="{Binding HomeSubtitle}"
                                   FontSize="12.5" Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="RearrangeBtn" Theme="{StaticResource IconButton}" Width="34" Height="34"
                                FontSize="15" FontFamily="{StaticResource IconFont}" Content="&#xE76F;"
                                Foreground="{DynamicResource CanvasTextBrush}"
                                ToolTip.Tip="Rearrange notebooks (drag them around, click again when done)"/>
                        <Button x:Name="SortBtn" Theme="{StaticResource IconButton}" Width="34" Height="34"
                                FontSize="15" FontFamily="{StaticResource IconFont}" Content="&#xE8CB;"
                                Foreground="{DynamicResource CanvasTextBrush}" ToolTip.Tip="Sort notebooks"/>
                        <Button x:Name="NewNotebookBtn"
                                Theme="{StaticResource LumenButton}" Command="{Binding AddNotebookCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="New notebook" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- recently edited pages, one click from anywhere -->
                <StackPanel Spacing="8" IsVisible="{Binding HasRecents}">
                    <TextBlock Text="JUMP BACK IN" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                    <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentPages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentPage">
                                <Border Classes="recentchip" Margin="0,0,10,10" CornerRadius="10"
                                        Background="{DynamicResource CanvasChipBrush}"
                                        BorderBrush="{DynamicResource CanvasChipBorderBrush}" BorderThickness="1"
                                        Cursor="Hand">
                                    <Panel>
                                        <Border Classes="chipfx" CornerRadius="9" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                    <GradientStop Offset="0" Color="#21FFFFFF"/>
                                                    <GradientStop Offset="0.5" Color="#00FFFFFF"/>
                                                    <GradientStop Offset="1" Color="#14000000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="12,8">
                                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                    Background="{Binding Color, Converter={x:Static v:Converters.HexBrush}}"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource CanvasTextBrush}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                           Foreground="{DynamicResource CanvasTextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl x:Name="HomeCards" ItemsSource="{Binding Notebooks}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Notebook">
                            <!-- Fixed cell sized so EVERYTHING (static shadow halo + hover growth) fits fully
                                 inside it — nothing ever draws past the item boundary, so nothing can clip. -->
                            <Panel Width="224" Height="162" Margin="0,0,2,2">
                                <Border Width="196" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="14" Background="#01000000" IsHitTestVisible="False"
                                        BoxShadow="0 2 10 0 #59000000"/>
                                <Border Classes="nbcard" Width="196" Height="132"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="14" Cursor="Hand" BorderThickness="1"
                                        Background="{Binding Color, Converter={x:Static v:Converters.HexBrush}}"
                                        BorderBrush="{Binding Color, Converter={x:Static v:Converters.CoverBorder}}">
                                    <Panel>
                                        <!-- optional photo cover (rounded via brush fill, sits under the scrim) -->
                                        <Border CornerRadius="13"
                                                Background="{Binding CoverPath, Converter={x:Static v:Converters.CoverImage}}"/>
                                        <!-- top-lit gloss + hairline: hidden by the "Flat covers" preference -->
                                        <Border Classes="cardfx" CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="#38FFFFFF">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                    <GradientStop Offset="0" Color="#2BFFFFFF"/>
                                                    <GradientStop Offset="0.45" Color="#00FFFFFF"/>
                                                    <GradientStop Offset="1" Color="#26000000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- caption scrim: always on (keeps labels readable on photos and flat covers) -->
                                        <Border CornerRadius="13">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                    <GradientStop Offset="0.45" Color="#00000000"/>
                                                    <GradientStop Offset="0.70" Color="#38000000"/>
                                                    <GradientStop Offset="1" Color="#73000000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Panel>
                                            <TextBlock Text="{Binding Name, Converter={x:Static v:Converters.Initials}}"
                                                       FontSize="30" FontWeight="Bold" Foreground="#59FFFFFF"
                                                       Margin="16,12,0,0"
                                                       IsVisible="{Binding CoverPath, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                                            <StackPanel Spacing="2" Margin="14,0,14,10" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ., Converter={x:Static v:Converters.NotebookStats}}"
                                                           FontSize="11" Foreground="#CCFFFFFF"/>
                                            </StackPanel>
                                        </Panel>
                                    </Panel>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Preferences, homepage style: a proper filled button floating bottom-right -->
        <Button x:Name="HomePrefsBtn" Theme="{StaticResource LumenButton}"
                IsVisible="{Binding IsHomeVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Preferences" FontSize="13"/>
            </StackPanel>
        </Button>

        <DockPanel x:Name="BodyDock" IsVisible="{Binding !IsHomeVisible}">
        <v:FormatToolbar x:Name="Toolbar" DockPanel.Dock="Top"/>
        <Grid ColumnDefinitions="Auto,Auto,*">

            <!-- Notebooks rail -->
            <Border Grid.Column="0" Width="64" IsVisible="{Binding IsRailVisible}"
                    Background="{DynamicResource FrameBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,10">
                    <Button DockPanel.Dock="Bottom" Theme="{StaticResource IconButton}" Width="40" Height="40"
                            HorizontalAlignment="Center" Margin="0,8,0,0" FontFamily="{StaticResource IconFont}"
                            Content="&#xE710;" Command="{Binding AddNotebookCommand}" ToolTip.Tip="New notebook"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="NotebooksList" Classes="rail" Background="Transparent" BorderThickness="0"
                                 HorizontalAlignment="Center" Padding="0"
                                 ItemsSource="{Binding Notebooks}"
                                 SelectedItem="{Binding SelectedNotebook, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Notebook">
                                    <Border Width="40" Height="40" CornerRadius="12" BorderThickness="1"
                                            Background="{Binding Color, Converter={x:Static v:Converters.HexBrush}}"
                                            BorderBrush="{Binding Color, Converter={x:Static v:Converters.CoverBorder}}"
                                            ToolTip.Tip="{Binding Name}">
                                        <Panel>
                                            <Border Classes="cardfx" CornerRadius="11">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                        <GradientStop Offset="0" Color="#2EFFFFFF"/>
                                                        <GradientStop Offset="0.5" Color="#00FFFFFF"/>
                                                        <GradientStop Offset="1" Color="#2E000000"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding Name, Converter={x:Static v:Converters.Initials}}"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Sections + pages -->
            <Border Grid.Column="1" Width="224" IsVisible="{Binding IsPagesVisible}"
                    Background="{DynamicResource FrameBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,12,12,0">

                    <TextBox x:Name="NotebookName" DockPanel.Dock="Top" Theme="{StaticResource RoundedFieldTextBox}"
                             Classes="rename" FontSize="16" FontWeight="SemiBold"
                             PlaceholderText="Notebook" Text="{Binding SelectedNotebook.Name, Mode=TwoWay}"/>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,4">
                        <TextBlock Text="Sections" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Theme="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                FontFamily="{StaticResource IconFont}" Content="&#xE710;"
                                Command="{Binding AddSectionCommand}" ToolTip.Tip="New section"/>
                        <Button x:Name="RenameSectionBtn" Grid.Column="3" Theme="{StaticResource IconButton}" Width="24" Height="24"
                                FontSize="12" FontFamily="{StaticResource IconFont}" Content="&#xE70F;"
                                ToolTip.Tip="Rename section"/>
                    </Grid>
                    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListBox x:Name="SectionsList" Classes="sections" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemsSource="{Binding SelectedNotebook.Sections}"
                                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Section">
                                    <Panel>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsEditing}"/>
                                        <TextBox Classes="inlineedit" Theme="{StaticResource RoundedFieldTextBox}"
                                                 FontSize="12.5" Text="{Binding Name, Mode=TwoWay}"
                                                 IsVisible="{Binding IsEditing}"/>
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,4">
                        <TextBlock Text="Pages" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Theme="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                FontFamily="{StaticResource IconFont}" Content="&#xE710;"
                                Command="{Binding AddPageCommand}" ToolTip.Tip="New page"/>
                    </Grid>

                    <ListBox x:Name="PagesList" Classes="pages" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemsSource="{Binding SelectedSection.Pages}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Page">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Page area: an OPAQUE canvas plate with a rounded HOLE punched under the page box
                 (clip set in code), so the acrylic backdrop blurs through the page ONLY — solid
                 themes get a real-glass page with solid surroundings. -->
            <Panel Grid.Column="2">
            <Border x:Name="CanvasPlate" Background="{DynamicResource CanvasBackgroundBrush}"/>
            <!-- Page: title + freeform canvas of note containers -->
            <Border Margin="14" CornerRadius="14"
                    Background="{DynamicResource PaperBackgroundBrush}" BorderBrush="{DynamicResource PaperBorderBrush}" BorderThickness="1">
                <DockPanel x:Name="PageDock">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="26,22,26,0"
                          IsVisible="{Binding SelectedPage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBox x:Name="PageTitle" Classes="rename"
                                 Theme="{StaticResource RoundedFieldTextBox}"
                                 Foreground="{DynamicResource PaperTextBrush}"
                                 FontSize="26" FontWeight="SemiBold" PlaceholderText="Page title"
                                 Text="{Binding SelectedPage.Title, Mode=TwoWay}"/>
                        <Button x:Name="HistoryBtn" Grid.Column="1" Theme="{StaticResource IconButton}"
                                Width="30" Height="30" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}" Content="&#xE81C;"
                                IsVisible="{Binding DeletedHistory}" ToolTip.Tip="Deleted containers"/>
                    </Grid>
                    <Panel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Margin="16,12,16,16">
                            <editor:NoteCanvas x:Name="PageCanvas"/>
                        </ScrollViewer>
                        <!-- Deleted-containers history: drag a card onto the page to bring it back -->
                        <Border x:Name="TrashPanel" IsVisible="False" Width="238"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,10,12,12"
                                CornerRadius="10" Background="#E8191B24"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <DockPanel Margin="12,10,12,12">
                                <TextBlock DockPanel.Dock="Top" Text="Deleted containers"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock DockPanel.Dock="Top" Text="Drag one onto the page to bring it back."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="TrashList" Spacing="6"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Panel>
                </DockPanel>
            </Border>
            </Panel>
        </Grid>
        </DockPanel>

        </Panel>
    </Grid>
</UserControl>
