<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumenotepad.Views.FormatToolbar">

    <UserControl.Styles>
        <!-- Attached to the PAGE the strip sits on paper (dark glass on light themes!) — its
             icons must follow the paper region's text, not the frame's. -->
        <!-- :is() — a plain type selector matches the EXACT type only; FormatToolbar is a
             UserControl SUBCLASS, so "UserControl.onpaper" would never match. -->
        <Style Selector=":is(UserControl).onpaper Button">
            <Setter Property="Foreground" Value="{DynamicResource PaperTextBrush}"/>
        </Style>
        <Style Selector=":is(UserControl).onpaper TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PaperTextBrush}"/>
        </Style>
        <!-- active (format applies at caret/selection) -->
        <Style Selector="Button.on"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
        <Style Selector="Button.on /template/ Border#bg">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- swatch buttons inside flyouts -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.swatch:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
        <!-- compact type-in size field -->
        <Style Selector="TextBox#SizeBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox#SizeBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="Chrome" Padding="5,3">
        <DockPanel x:Name="ChromeDock">
            <Button x:Name="DockBtn" DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE712;" ToolTip.Tip="Toolbar position"/>
            <!-- Customize sits at the FAR end, away from the formatting tools (owner request) -->
            <Button x:Name="CustomizeBtn" DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE790;" ToolTip.Tip="Customize notebook"/>
            <StackPanel x:Name="Panel" Orientation="Horizontal" Spacing="1">

            <Button x:Name="BoldBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE8DD;" ToolTip.Tip="Bold (Ctrl+B)"/>
            <Button x:Name="ItalicBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE8DB;" ToolTip.Tip="Italic (Ctrl+I)"/>
            <Button x:Name="UnderBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE8DC;" ToolTip.Tip="Underline (Ctrl+U)"/>
            <Button x:Name="StrikeBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xEDE0;" ToolTip.Tip="Strikethrough (Ctrl+Shift+S)"/>

            <Button x:Name="BulletBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE8FD;" ToolTip.Tip="Bullets &amp; lists (Ctrl+Shift+8)">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="4" x:Name="BulletChoices"/>
                            <!-- number-style override for the list under the caret (shown on "num") -->
                            <StackPanel Orientation="Horizontal" Spacing="4" x:Name="NumStylePanel" IsVisible="False"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button x:Name="HighlightBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE7E6;" ToolTip.Tip="Highlight (Ctrl+Shift+H)">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="6" x:Name="HighlightSwatches"/>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button x:Name="ColorBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                    FontFamily="{StaticResource IconFont}" Content="&#xE8D3;" ToolTip.Tip="Text color">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="6" x:Name="ColorSwatches"/>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <StackPanel x:Name="SizeGroup" Orientation="Horizontal" Spacing="0">
                <Button x:Name="SizeMinus" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="11"
                        FontFamily="{StaticResource IconFont}" Content="&#xE949;" ToolTip.Tip="Smaller"/>
                <TextBox x:Name="SizeBox" Theme="{StaticResource RoundedFieldTextBox}"
                         Width="30" Height="26" FontSize="12" Text="15"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         TextAlignment="Center" ToolTip.Tip="Font size — type a number and press Enter"/>
                <Button x:Name="SizePlus" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="11"
                        FontFamily="{StaticResource IconFont}" Content="&#xE948;" ToolTip.Tip="Larger"/>
            </StackPanel>

            <Button x:Name="FontBtn" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="13"
                    Content="Aa" ToolTip.Tip="Font">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="230" Spacing="6">
                            <TextBlock Text="Font" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <ListBox x:Name="FontList" MaxHeight="320" Background="Transparent" FontSize="13"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
