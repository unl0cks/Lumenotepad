<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumenotepad.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- Scrollbar look lives in Themes/Theme.axaml as a full ControlTheme replacement:
             Fluent's scrollbar keeps its chunky expanded state (track plate + arrow buttons)
             regardless of what plain styles here say. -->
        <!-- App-wide button press feedback: a quick opacity dip. Opacity animates in this build
             (RenderTransform does not — see the motion spec), so this is declarative and global. -->
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.11"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <!-- App-wide combo rounding (owner: dropdowns should be "more rounded"). The popup's own
             content border in Fluent's ComboBox template is named "PopupBorder" — if a future Fluent
             build renames it this selector simply fails to match (silent, acceptable fallback). -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <!-- Themed rounded menus (owner: right-click menus rounded + themed to match the active
             theme). MenuBackgroundBrush/MenuBorderBrush are written by ThemeManager.Apply from the
             new ThemeTokens.MenuBackground/MenuBorder. Flyout (toolbar pickers) is a DIFFERENT type
             from ContextMenu/MenuFlyoutPresenter — these selectors must never hit it. -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <!-- Toolbar picker flyouts (bullets/highlight/color/font) wear the same themed menu
             material — MenuFx blurs their popup window on the Lumen glass variant too. -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
    </Application.Styles>
</Application>
