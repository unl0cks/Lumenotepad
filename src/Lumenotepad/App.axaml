<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumenotepad.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- Scrollbar look lives in Themes/Theme.axaml as a full ControlTheme replacement:
             Fluent's scrollbar keeps its chunky expanded state (track plate + arrow buttons)
             regardless of what plain styles here say. -->
    </Application.Styles>
</Application>
